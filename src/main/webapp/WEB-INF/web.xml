<!DOCTYPE web-app PUBLIC
        "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd" >


<web-app>
    <display-name>Archetype Created Web Application</display-name>
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>
    <error-page>
        <exception-type>org.example.service.exceptions.WrongLoginOrPassword</exception-type>
        <location>/exceptions/wrongLoginOrPassword.jsp</location>
    </error-page>
    <error-page>
        <exception-type>org.example.service.exceptions.WrongPassword</exception-type>
        <location>/exceptions/wrongPassword.jsp</location>
    </error-page>
    <error-page>
        <exception-type>org.example.service.exceptions.UserAlreadyExists</exception-type>
        <location>/exceptions/userAlreadyExists.jsp</location>
    </error-page>
    <error-page>
        <exception-type>org.example.service.exceptions.DifferentPasswordsRegistration</exception-type>
        <location>/exceptions/differentPasswordsRegistration.jsp</location>
    </error-page>
    <error-page>
        <exception-type>org.example.service.exceptions.DifferentPasswordsUpdate</exception-type>
        <location>/exceptions/differentPasswordsUpdate.jsp</location>
    </error-page>
</web-app>
